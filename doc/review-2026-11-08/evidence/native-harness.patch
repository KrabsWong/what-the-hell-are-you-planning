+fn native_review_seed() {
+    let root = std::path::PathBuf::from("/Users/fuxingxing/workspaces/what-the-hell-are-you-planning/.local/native-review/data");
+    if root.join("workspace/workspace.sqlite3").exists() { return; }
+    std::fs::create_dir_all(&root).unwrap();
+    let data = workspace::initialize(&root, None).unwrap();
+    let storage = persistence::Storage::new(data.join("workspace.sqlite3"));
+    let mut store = storage.load().unwrap().unwrap();
+    store.projects[0].name = "Review laboratory".into();
+    store.opencode_path = "/Users/fuxingxing/workspaces/what-the-hell-are-you-planning/.local/native-review/fixture-agent".into();
+    store.default_model = "fixture/research".into();
